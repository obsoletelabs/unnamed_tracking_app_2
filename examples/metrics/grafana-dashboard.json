    {
      "id": 101,
      "type": "row",
      "title": "HTTP traffic · route filter applies here",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second by status class",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "sum by (status_class) (rate(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request latency (p50 / p95 / p99)",
      "description": "Measured until the response starts; response-body transfer is not included. Quantiles need observations in the rate window.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "C",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Slowest routes (p95)",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
