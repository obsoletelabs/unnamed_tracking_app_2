        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval]))))",
          "legendFormat": "{{route}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "5xx and 429 responses by route",
      "description": "Uses the dedicated 429 counter as well as 5xx responses. Empty series can mean no matching errors have been observed; they do not prove that a route was exercised.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "^429"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "expr": "topk(10, sum by (route) (rate(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",status_class=\"5xx\"}[$__rate_interval])))",
          "legendFormat": "5xx · {{route}}",
          "refId": "A",
          "editorMode": "code",
          "range": true,
          "instant": false
        },
        {
          "expr": "topk(10, sum by (route) (rate(uta_http_rate_limited_responses_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "429 · {{route}}",
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false
        }
      ]
    },
