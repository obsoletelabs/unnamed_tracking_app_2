      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool) (rate(uta_database_named_pool_timeouts_total{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval]))",
          "legendFormat": "{{pool}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "min": 0
