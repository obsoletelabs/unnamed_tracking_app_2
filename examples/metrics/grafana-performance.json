{
  "schemaVersion": 39,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "job",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_ready, job)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_ready, job)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "unnamed-tracking",
          "value": "unnamed-tracking"
        },
        "options": []
      },
      {
        "name": "instance",
        "label": "Instance",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(up{job=\"$job\"}, instance)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(up{job=\"$job\"}, instance)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "route",
        "label": "HTTP route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_http_requests_total{job=\"$job\",instance=~\"$instance\"}, route)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_http_requests_total{job=\"$job\",instance=~\"$instance\"}, route)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "method",
        "label": "HTTP method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}, method)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}, method)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "pool",
        "label": "Database pool",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_database_pool_wait_seconds_count{job=\"$job\",instance=~\"$instance\"}, pool)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_database_pool_wait_seconds_count{job=\"$job\",instance=~\"$instance\"}, pool)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "query_group",
        "label": "Query family",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_database_query_group_duration_seconds_count{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}, query_group)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_database_query_group_duration_seconds_count{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}, query_group)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "phase",
        "label": "Request phase",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(uta_http_phase_duration_seconds_count{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}, phase)",
          "refId": "StandardVariableQuery"
        },
        "definition": "label_values(uta_http_phase_duration_seconds_count{job=\"$job\",instance=~\"$instance\",route=~\"$route\"}, phase)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "id": null,
  "uid": "uta-page-performance",
  "title": "Unnamed Tracking \u00b7 Page performance",
  "version": 1,
  "tags": [
    "unnamed-tracking",
    "performance"
  ],
  "description": "Backend response start, phase, SQL and runtime latency. Query families are bounded categories; phases can overlap. Browser queueing and rendering are outside these server measurements.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Response start \u00b7 p50 / p95 / p99",
      "description": "Backend time before response headers. Excludes browser connection queues, proxy work and client parsing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": " p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": " p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": " p99",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Named phases \u00b7 p50 / p95 / p99",
      "description": "Per-request accumulated phase durations before headers. Auth and runtime phases include their nested SQL/network work; do not add overlapping phases together.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, phase) (rate(uta_http_phase_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\",phase=~\"$phase\"}[$__rate_interval])))",
          "legendFormat": "{{phase}} p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, phase) (rate(uta_http_phase_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\",phase=~\"$phase\"}[$__rate_interval])))",
          "legendFormat": "{{phase}} p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, phase) (rate(uta_http_phase_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\",phase=~\"$phase\"}[$__rate_interval])))",
          "legendFormat": "{{phase}} p99",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Slowest response-start routes \u00b7 p95",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, route) (rate(uta_http_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval]))))",
          "legendFormat": "{{route}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Requests and errors",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval]))",
          "legendFormat": "{{status_class}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "SQL executions per request \u00b7 mean",
      "description": "Counts before headers divided by matching HTTP requests. Not a count of logical API operations or rows; idle windows are undefined.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool, query_group) (rate(uta_http_database_queries_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\",pool=~\"$pool\",query_group=~\"$query_group\"}[$__rate_interval])) / scalar(sum(rate(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} \u00b7 {{query_group}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "SQL cursor time per request \u00b7 mean",
      "description": "Driver execution time only, excluding pool acquisition, commit and ORM/result processing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pool, query_group) (rate(uta_http_database_query_seconds_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\",pool=~\"$pool\",query_group=~\"$query_group\"}[$__rate_interval])) / scalar(sum(rate(uta_http_requests_total{job=\"$job\",instance=~\"$instance\",route=~\"$route\",method=~\"$method\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} \u00b7 {{query_group}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Individual SQL calls \u00b7 all routes",
      "description": "Deployment/instance/pool/family scoped; the HTTP route filter does not apply to individual SQL call samples.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pool, query_group) (rate(uta_database_query_group_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\",query_group=~\"$query_group\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} \u00b7 {{query_group}} p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool, query_group) (rate(uta_database_query_group_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\",query_group=~\"$query_group\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} \u00b7 {{query_group}} p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, pool, query_group) (rate(uta_database_query_group_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\",query_group=~\"$query_group\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} \u00b7 {{query_group}} p99",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Pool queue and connection creation \u00b7 all routes",
      "description": "Application and isolated authentication pools; global across routes. Does not include SQL execution or commit.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, pool) (rate(uta_database_pool_wait_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, pool) (rate(uta_database_pool_wait_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, pool) (rate(uta_database_pool_wait_seconds_bucket{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"}[$__rate_interval])))",
          "legendFormat": "{{pool}} p99",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Pool connections \u00b7 all routes",
      "description": "Reads current pool objects without executing SQL. Available for single-worker exporters.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (pool, state) (uta_database_named_pool_connections{job=\"$job\",instance=~\"$instance\",pool=~\"$pool\"})",
          "legendFormat": "{{pool}} \u00b7 {{state}}",
          "range": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pool exhaustion \u00b7 all routes",
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "datasource": {
        "type": "prometheus",
