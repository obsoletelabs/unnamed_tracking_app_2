    {
      "id": 12,
      "type": "timeseries",
      "title": "Cache rebuilds \u00b7 all routes",
      "description": "Actual refresh/rebuilds, not cache hits. A warm artwork preview should not require resizing.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, cache_kind) (rate(uta_cache_refresh_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{cache_kind}} p50",
          "range": true,
          "editorMode": "code"
