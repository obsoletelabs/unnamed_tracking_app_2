        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, cache_kind) (rate(uta_cache_refresh_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{cache_kind}} p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, cache_kind) (rate(uta_cache_refresh_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
