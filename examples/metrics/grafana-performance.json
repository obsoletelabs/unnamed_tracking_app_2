          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Host \u2192 runtime calls \u00b7 all routes",
      "description": "Includes private HTTP transport, runtime validation and worker execution when applicable. Request phase plugin.runtime attributes accumulated work to the selected route.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(uta_plugin_runtime_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} p50",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(uta_plugin_runtime_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} p95",
          "range": true,
          "editorMode": "code"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(uta_plugin_runtime_request_duration_seconds_bucket{job=\"$job\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{operation}} p99",
          "range": true,
          "editorMode": "code"
