{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Presentation for one of the producer's own types; it never adds data or authority.",
  "properties": {
    "contract_version": {
      "title": "Contract Version",
      "type": "string"
    },
    "event_type": {
      "maxLength": 128,
      "minLength": 3,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "title": "Event Type",
      "type": "string"
    },
    "fields": {
      "default": [],
      "items": {
        "enum": [
          "title",
          "summary",
          "blocks",
          "facts",
          "images",
          "actions",
          "attribution",
          "occurred_at",
          "expires_at",
          "live_link"
        ],
        "type": "string"
      },
      "maxItems": 10,
      "title": "Fields",
      "type": "array"
    },
    "kind": {
      "enum": [
        "fields",
        "markdown_template",
        "html_template"
      ],
      "title": "Kind",
      "type": "string"
    },
    "surface": {
      "enum": [
        "card",
        "email",
        "chat",
        "push",
        "text"
      ],
      "title": "Surface",
      "type": "string"
    },
    "template": {
      "anyOf": [
        {
          "maxLength": 20000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Template"
    }
  },
  "required": [
    "contract_version",
    "event_type",
    "surface",
    "kind"
  ],
  "title": "RendererContribution",
  "type": "object",
  "x-notification-contract-version": "1.0.0"
}
