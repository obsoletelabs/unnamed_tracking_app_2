          "default": null,
          "title": "Next Episode At"
        }
      },
      "title": "MetadataAiring",
      "type": "object"
    },
    "MetadataCandidate": {
      "additionalProperties": false,
      "description": "Lightweight identity; metadata and artwork are separate operations.",
      "properties": {
        "external_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "External Id",
          "type": "string"
