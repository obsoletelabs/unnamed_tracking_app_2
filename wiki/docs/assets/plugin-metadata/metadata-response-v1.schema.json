        "year": {
          "anyOf": [
            {
              "maximum": 3000,
              "minimum": 1800,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        },
        "provider": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "media_type": {
          "$ref": "#/$defs/MediaType",
          "default": "game"
