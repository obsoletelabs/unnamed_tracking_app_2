    "MediaAsset": {
      "additionalProperties": false,
      "description": "An asset reference; providers never write the host filesystem.",
      "properties": {
        "kind": {
          "enum": [
            "key_art",
            "banner",
            "logo",
            "icon",
            "screenshot",
            "hero",
            "poster"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "minLength": 1,
          "title": "Url",
          "type": "string"
        },
        "priority": {
          "default": 100,
          "maximum": 10000,
          "minimum": 0,
          "title": "Priority",
          "type": "integer"
        },
        "width": {
          "anyOf": [
            {
              "maximum": 50000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "height": {
          "anyOf": [
            {
              "maximum": 50000,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "title": "MediaAsset",
      "type": "object"
    },
    "MediaType": {
      "description": "Canonical library domains supported by provider capabilities.",
      "enum": [
        "game",
        "movie",
        "tv_show",
        "anime"
      ],
