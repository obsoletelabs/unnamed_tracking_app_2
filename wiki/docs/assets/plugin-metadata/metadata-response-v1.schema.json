          "maxItems": 20,
          "title": "Alternate Titles",
          "type": "array"
        },
        "provider_ids": {
          "maxProperties": 32,
          "patternProperties": {
            "^[a-z0-9][a-z0-9._-]*$": {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            }
