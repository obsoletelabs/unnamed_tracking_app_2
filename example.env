# PostgreSQL deployment inputs. New deployments should use these instead of DATABASE_URL.
POSTGRES_USER=archive
POSTGRES_PASSWORD=change-this-database-password
POSTGRES_DB=archive
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Startup profile:
#   dev/development = development defaults, skip setup UI after installation
#   testing = show setup UI, use testing defaults where defined, otherwise development defaults
#   empty/anything else = show setup UI and use normal defaults
STARTUP_MODE=

# SECRET_KEY is deployment-owned. If omitted, the application generates and
# persists a stable Fernet key under APP_DATA_DIR/config.
SECRET_KEY=

# Shared only by the host application and Plugin Runtime. Generate with:
# openssl rand -base64 48
PLUGIN_RUNTIME_TOKEN=

# Optional development-only override for the repository-root compose.yaml.
# Production deployments use PLUGIN_RUNTIME_TOKEN.
# PLUGIN_RUNTIME_DEV_TOKEN=

AUTH_COOKIE_SECURE=false
# Shared authentication quotas. All backend workers/replicas must use the same
# PostgreSQL database, SECRET_KEY and threshold settings. See the authentication
# protection deployment guide before changing these environment-only defaults.
# AUTH_RATE_LIMIT_PERCENT=100
# AUTH_LOGIN_ACCOUNT_PER_MINUTE=8
# AUTH_LOGIN_ACCOUNT_PER_15_MINUTES=20
# AUTH_LOGIN_IP_PER_MINUTE=120
# AUTH_LOGIN_IP_FAILURES_PER_15_MINUTES=50
# AUTH_PASSWORD_WORKERS=2
# Prometheus metrics at /metrics (off by default). Leave METRICS_TOKEN empty to have a token
# generated and saved, or set one of at least 32 characters (openssl rand -hex 32).
# See wiki/docs/deployment/metrics.md before exposing a port.
# METRICS_ENABLED=false
# METRICS_TOKEN=
# METRICS_LISTEN_PORT=
DEBUG=false
# Set false to stop remote ICS fetching deployment-wide while retaining cached calendars.
CALENDAR_SUBSCRIPTIONS_ENABLED=true
# Default built-in presentation: modern or classic. Leave empty to configure
# through Setup > General; saved account and browser choices take priority.
DEFAULT_UI_STYLE=
# Upload size caps are editable in Setup > Limits. Setting one here locks it (the
# environment value wins), so leave these commented unless you want that.
# MAX_UPLOAD_SIZE_MB=15
# Each file in a game's Docs tab (any file type), separate from the image cap.
# MAX_DOC_SIZE_MB=500
# MAX_SAVE_ARCHIVE_SIZE_MB=4096
# MAX_CLIP_SIZE_MB=500
# MAX_WORLD_SAVE_SIZE_MB=2000

# Frontend-only early-stage development/testing switch. It is consumed by Vite,
# remains outside the backend configuration registry, and is intentionally not
# editable through /setup.
VITE_USE_MOCK_DATA=false

# Optional deployment-wide provider credentials. Values supplied here are
# authoritative and will be shown as locked fields by /setup.
STEAMGRIDDB_API_KEY=
RETROACHIEVEMENTS_API_KEY=
GIANTBOMB_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
TMDB_API_KEY=
OMDB_API_KEY=
TVDB_API_KEY=
SCREENSCRAPER_DEVID=
SCREENSCRAPER_DEVPASSWORD=
SCREENSCRAPER_SSID=
SCREENSCRAPER_SSPASSWORD=
XBOX_CLIENT_ID=
XBOX_CLIENT_SECRET=

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI is generated automatically from the URL used to access the application.
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
OIDC_USER_MATCH_FIELD=email
# Optional; off by default. Set true only when the provider supplies email_verified=true.
# OIDC_REQUIRE_VERIFIED_EMAIL=false

# Legacy compatibility only; prefer the three POSTGRES_* variables above.
# DATABASE_URL=postgresql+psycopg://archive:change-this-database-password@db:5432/archive

# Legacy first-user bootstrap. The normal setup UI is preferred.
# PRIMARY_USER_USERNAME=admin
# PRIMARY_USER_EMAIL=admin@example.com
# PRIMARY_USER_PASSWORD=Change-this-during-setup
# Path to the reviewed publisher trust policy. It replaces raw publisher-key environment entries.
# PLUGIN_TRUSTED_PUBLISHER_REGISTRY=/run/config/plugin-trusted-publishers.json
# PLUGIN_CATALOG_URL=https://raw.githubusercontent.com/obsoletelabs/unnamed_tracking_app_plugins/main/list.json
# PLUGIN_CATALOGUE_REGISTRY=/data/plugin-catalogues.json
# Password reset and invites are enabled by the optional official.password-reset and
# official.user-invites plugins; both use the built-in notification delivery controller.
# Password reset is enabled/configured by the optional official.password-reset plugin,
# using verified external notification destinations. SMTP remains built in; the
# plugin receives no SMTP credentials. Reset revokes sessions and retains API keys.

# Optional notification routing restrictions. These can raise requirements or
# block routes; they cannot lower a notification's sensitivity requirement.
NOTIFICATION_BLOCKED_PROVIDERS=
NOTIFICATION_BLOCKED_TYPES=
# 0 = PUBLIC, 1 = PRIVATE, 2 = SECURE
NOTIFICATION_MINIMUM_TRUST=0
# Allow user quiet hours, digests and mute rules; false uses each event type's default timing.
NOTIFICATION_TIMING_ENABLED=true
# Allow Critical requests to interrupt quiet hours and grouping.
NOTIFICATION_URGENT_BYPASS_ENABLED=true
# Later changes to a story an external destination already received, when its provider cannot edit
# the earlier message: important (warning/error/critical only), all, or none.
NOTIFICATION_FOLLOW_UPS=important
# What browser/PWA notifications show on the device: generic (constant text, safe for locked
# screens) or story (the item's own title and summary). Clicks always open the signed-in story page.
NOTIFICATION_BROWSER_PREVIEWS=generic
# Inbox history default and optional maximum. 0 means unlimited/no maximum.
NOTIFICATION_RETENTION_DEFAULT_DAYS=30
NOTIFICATION_RETENTION_MAXIMUM_DAYS=0
# Separate content-free plugin lifecycle audit history; positive days only.
NOTIFICATION_AUDIT_RETENTION_DAYS=90

# Optional built-in SMTP. Settings → Administration → Notifications.
# Nonempty ENV values lock the corresponding settings UI. The admin test button
# uses the effective saved/ENV credentials and defaults to the admin's app email.
# Leave SMTP_PORT unset for TLS 465 / STARTTLS 587 / plaintext 25.
# SMTP_TLS_MODE accepts starttls (default), ssl (implicit TLS), or none (warning).
# For mailbox one-click unsubscribe, the SMTP relay must DKIM-sign both
# List-Unsubscribe and List-Unsubscribe-Post. The host supplies these for HTTPS
# subscription links; security, verification and test emails have no opt-out.
SMTP_HOST=
SMTP_PORT=
SMTP_FROM_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_MODE=
# Browser push server identity. Requires the enabled official PWA lifecycle.
# Use an explicit mailto contact or HTTPS contact URL; no account email fallback.
# Private key is base64 DER P-256 material, not a filename. Keep it stable:
# changing it requires new browser subscriptions. Nonempty ENV values lock UI.
# Admin API can generate a key without exposing the private value.
WEB_PUSH_VAPID_SUBJECT=
WEB_PUSH_VAPID_PRIVATE_KEY=
# Optional shared HTTPS public FQDN; notification URL preferences override it.
# Otherwise links fall back to each signed-in user's last-used app origin.
# Independent of OIDC. Also configurable through setup/Application settings.
PUBLIC_APP_URL=

# Production HTTPS. Also configurable under Administration → Application.
# Saving in the app validates and reloads Nginx automatically; ENV changes
# require container recreation. Mount PEM files at these absolute paths.
# NGINX_TLS_ENABLED=false
# NGINX_TLS_REDIRECT_HTTP=false
# HTTPS port named by the redirect. The example Compose file publishes container
# port 443 as UNNAMED_TRACKING_APP_HTTPS_PORT (default 8443) and uses that here.
# UNNAMED_TRACKING_APP_HTTPS_PORT=8443
# NGINX_TLS_REDIRECT_PORT=8443
# NGINX_TLS_CERTIFICATE=/etc/nginx/tls/tls.crt
# NGINX_TLS_PRIVATE_KEY=/etc/nginx/tls/tls.key
# Trusted proxy settings. Trust only proxies you operate/use. In-app quick-add
# presets include local/private, CGNAT/VPS and Cloudflare ranges.
# NGINX_REALIP_HEADER=X-Forwarded-For
# NGINX_REALIP_TRUSTED_PROXIES=127.0.0.1/32 ::1/128

# Discord network policy belongs to the separate plugin-runtime container.
# Supply this there (Compose currently enables it explicitly), not only to the app.
# It gates protected host-broker delivery as well as the legacy compatibility path.
# The official provider never receives webhook tokens; users enroll them in
# Account → Notifications. false disables Discord egress without lowering trust.
# PLUGIN_RUNTIME_DISCORD_EGRESS=false
